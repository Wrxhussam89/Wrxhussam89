# Base URL of YOUR backend (not the ERP itself). Your backend should hold
# the real ERP API key/secret server-side and proxy requests to the ERP.
# Leave unset to run the site in local demo mode (no backend required).
VITE_API_BASE_URL=

# Access code for the /admin staff dashboard (demo mode default: evmaster-admin)
VITE_ADMIN_DEMO_CODE=
