# ── Appwrite backend ──────────────────────────────────────────────
# Set VITE_APPWRITE_PROJECT_ID to connect to Appwrite.
# Leave it empty to run in demo mode (localStorage, no backend).
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DB_ID=evmaster

# Admin login — the admin account's email address in Appwrite.
# The admin user must have the "admin" label in Appwrite console.
VITE_ADMIN_EMAIL=admin@evmasterjo.com

# ── Demo mode only ───────────────────────────────────────────────
# Access code for the /admin staff dashboard (default: evmaster-admin)
VITE_ADMIN_DEMO_CODE=evmaster-admin
